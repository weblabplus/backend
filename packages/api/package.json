{
  "name": "@medilab/api",
  "version": "1.0.0",
  "private": true,
  "description": "MediLab REST API with PostgreSQL authentication",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "test": "jest",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@medilab/core": "*",
    "@medilab/lab-parser": "*",
    "@medilab/ml-engine": "*",
    "@medilab/reference-ranges": "*",
    "@medilab/report-generator": "*",
    "@medilab/rule-engine": "*",
    "better-auth": "^1.7.11",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/pg": "^8.20.4",
    "rimraf": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
