# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

PORT=3001
NODE_ENV=development

# PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth (Neon PostgreSQL)
# Δημιουργήστε ένα τυχαίο secret, π.χ.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001
# Origin(s) του frontend - comma-separated, wildcards για Vercel previews
# π.χ. https://frontend-woad-xi-87.vercel.app,https://*.vercel.app
WEB_ORIGIN=http://localhost:3000
CORS_ORIGIN=

# Φάκελος disk caches (exam catalog / LOINC). Default: <cwd>/data ή <cwd>/packages/api/data
DATA_DIR=

# Προσωρινός κωδικός για λογαριασμούς που δεν έχουν credentials στο Better Auth (legacy migration)
AUTH_DEFAULT_PASSWORD=123456

# E-Fulfillment API (e-Prescription / ΗΔΙΚΑ)
EFULFILLMENT_BASE_URL=https://testeps.e-prescription.gr/efulfillment
EFULFILLMENT_API_KEY=your-application-api-key
# Κλειδί κρυπτογράφησης των credentials φορέα στη βάση (AES-256-GCM)
EFULFILLMENT_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Ο φορέας ακυρώνει τη σύνδεση μετά από 24h — ανανεώνουμε στις 20h
EFULFILLMENT_REFRESH_HOURS=20
EFULFILLMENT_TICK_MINUTES=30
EFULFILLMENT_TIMEOUT_MS=15000
# Lab Data Repository (Master Data + ���������� �������������)
LAB_REPO_BASE_URL=https://testeps.e-prescription.gr/labdatarepository
LAB_REPO_USERNAME=your-lab-repo-username
LAB_REPO_PASSWORD=your-lab-repo-password
# �� ����, ��������������� �� EFULFILLMENT_API_KEY
LAB_REPO_API_KEY=

# Emporiko Documents API (κέντρο αναφοράς ΜΙΚΡΟΑΝΑΛΥΣΗ)
EMPORIKO_DOCUMENTS_URL=http://microanalysi.fortiddns.com:8000
EMPORIKO_DOCUMENTS_USERNAME=invoiceapi
EMPORIKO_DOCUMENTS_PASSWORD=your-documents-api-password
EMPORIKO_DOCUMENTS_CODE=0001
# Προαιρετικό timeout (ms)
EMPORIKO_DOCUMENTS_TIMEOUT_MS=30000

# GNews — ιατρικά νέα στο dashboard (GNews API)
# Μπαίνει στο frontend/.env.local (διαβάζεται server-side από το /api/news, δεν εκτίθεται στον browser)
GNEWS_API_KEY=your-gnews-api-key
