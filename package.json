{
  "name": "medilab-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MediLab Backend - Express REST API + analysis packages (independent project)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "npm run dev --workspace=@medilab/api",
    "start:api": "npm run start --workspace=@medilab/api",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "test": "turbo run test",
    "test:packages": "turbo run test --filter=./packages/*",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.16.0"
}
